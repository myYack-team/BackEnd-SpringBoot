# MyYak Server 환경변수 설정 예시
# 이 파일을 .env로 복사하여 실제 값을 입력하세요
# cp .env.example .env

# ============================================
# Database 설정
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=myYack
DB_USERNAME=root
DB_PASSWORD=YOUR_DB_PASSWORD
DB_USE_SSL=false

# ============================================
# JWT 설정 (최소 32자 이상)
# ============================================
JWT_SECRET=YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS

# ============================================
# OAuth 설정 (카카오)
# https://developers.kakao.com 에서 발급
# ============================================
KAKAO_CLIENT_ID=YOUR_KAKAO_CLIENT_ID
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# ============================================
# AI API 설정
# ============================================
# Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OpenAI: https://platform.openai.com
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ============================================
# 공공데이터포털 API (e약은요)
# https://www.data.go.kr
# ============================================
EASY_DRUG_API_KEY=YOUR_EASY_DRUG_API_KEY

# ============================================
# 개인정보 암호화 (AES-256-GCM)
# 생성: openssl rand -base64 32
# ============================================
ENCRYPTION_SECRET_KEY=YOUR_ENCRYPTION_SECRET_KEY_BASE64

# ============================================
# 디버그/테스트 설정
# ============================================
SAVE_SCAN_IMAGES=true
TEST_LOGIN_ENABLED=true
TEST_LOGIN_PASSWORD=YOUR_TEST_PASSWORD

# ============================================
# CORS 설정 (프로덕션용)
# 쉼표로 구분하여 여러 도메인 추가 가능
# ============================================
# CORS_ALLOWED_ORIGINS=https://myyak.com,https://api.myyak.com
