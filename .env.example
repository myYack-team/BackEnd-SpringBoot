# 마이약 백엔드 환경변수 설정
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 입력하세요.
# cp .env.example .env

# ===== Database =====
DB_URL=jdbc:mysql://localhost:3306/myyak
DB_USERNAME=root
DB_PASSWORD=

# ===== JWT =====
# 최소 32자 이상의 랜덤 문자열
JWT_SECRET=

# ===== Kakao OAuth =====
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# ===== AI API =====
# 개발: Gemini API
GEMINI_API_KEY=

# 프로덕션: OpenAI API
OPENAI_API_KEY=

# ===== Firebase (Push 알림) =====
# Firebase 서비스 계정 JSON 파일 경로
FIREBASE_CREDENTIALS_PATH=
